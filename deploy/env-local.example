# ════════════════════════════════════════════════════════════════════
#  Café del Valle POS · instalación en el LOCAL (mini PC de caja)
#
#      cp deploy/env-local.example .env
#
#  Rellena las XXX con los valores de la red del local antes de arrancar.
#  Si no vas a conectar impresoras todavía, usa env-prueba.example: no
#  menciona ninguna IP y funciona en cualquier red.
# ════════════════════════════════════════════════════════════════════

PORT=5174
NODE_ENV=production
HOST=0.0.0.0

# La IP del servidor NO va aquí: se le asigna al equipo desde el router.
# Las tablets entran a:   http://<IP-del-servidor>:5174

# ──────────────────────── impresoras ────────────────────────
# Caja: nombre del recurso compartido de Windows, tal como aparece en
# Configuración → Impresoras. Sin espacios raros ni acentos.
PRINTER_CAJA=windows://Receipt

# Cocina: impresora de red. Necesita IP FIJA — si el router se la cambia,
# la comanda deja de salir sin avisar.
# En la impresora:  IP 192.168.1.XXX · máscara 255.255.255.0 · gateway <router>
PRINTER_COCINA=tcp://192.168.1.XXX:9100

# ───────────────────────── respaldos ─────────────────────────
BACKUP_AUTO=on
BACKUP_HORA=3
BACKUP_CONSERVAR=30
# Copia adicional fuera del disco del equipo (carpeta sincronizada a la nube).
# BACKUP_COPIA=C:\Users\Caja\Mi unidad\Respaldos Cafe del Valle
