# ════════════════════════════════════════════════════════════════════
#  Café del Valle POS · pruebas fuera del local, con impresora real
#
#      cp deploy/env-oficina.example .env
#
#  OJO: la impresora de cocina lleva la IP de LA RED EN LA QUE ESTÁS.
#  Una plantilla con la IP de otro sitio deja la impresora muda, porque
#  esa dirección no existe en esta red. Comprueba el tercer número.
#
#  Si no vas a conectar la impresora, usa env-prueba.example.
# ════════════════════════════════════════════════════════════════════

PORT=5174
NODE_ENV=production
HOST=0.0.0.0

# ──────────────────────── impresoras ────────────────────────
# Caja: en Mac no hay recurso compartido de Windows, así que el ticket del
# cliente se escribe a disco. En la mini PC esta línea es windows://Receipt
PRINTER_CAJA=file://./server/data/tickets

# Cocina: impresora real de esta red.
PRINTER_COCINA=tcp://192.168.1.XXX:9100

# ───────────────────────── respaldos ─────────────────────────
BACKUP_AUTO=on
BACKUP_HORA=0
BACKUP_CONSERVAR=7
