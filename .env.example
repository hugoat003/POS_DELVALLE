# FUWA POS — configuración del servidor.
# Copiar como .env en la mini PC de caja. Sin .env el sistema funciona igual,
# solo que sin imprimir (los trabajos se descartan y quedan registrados).

PORT=5174
NODE_ENV=production

# ---------------------------------------------------------------- impresoras
# Sintaxis:
#   tcp://IP:PUERTO      impresora de red (puerto 9100 es el estándar RAW)
#   windows://RECURSO    impresora compartida en Windows (USB local)
#   windows://PC/RECURSO  compartida en otra PC de la red
#   file://RUTA          simulación: escribe el ticket a disco (desarrollo)
#   off                  desactivada

# Impresora del cliente: 3nstar RPT009 por USB en la mini PC de caja.
# Es la que NO debe depender de la red, por eso va por el recurso compartido
# local y no por TCP. En Windows hay que:
#   1. Instalar la impresora con el driver "Generic / Text Only"
#      (con el driver propio, el spooler intenta rasterizar el ESC/POS).
#   2. Compartirla:  Propiedades → Compartir → Nombre: RPT009
#   3. Probar desde Ajustes → Impresoras → Probar caja
PRINTER_CAJA=windows://RPT009

# Impresora de cocina: 3nstar RPT009 por LAN con IP fija.
#
# Hay dos formas de fijarla y las dos sirven:
#   a) Reserva por DHCP en el router (se ata a la MAC de la impresora).
#   b) IP estática configurada en la propia impresora.
#
# Si usas (b), la IP DEBE quedar FUERA del rango que reparte el DHCP del router.
# Si cae dentro, el router puede entregarle esa misma IP a un celular o a una
# tablet y las dos pelean por ella: la comanda deja de salir de forma
# intermitente, que es el fallo más difícil de diagnosticar.
#
# Ejemplo típico: si el router reparte de .100 a .200, usa .50
#   IP        192.168.1.50
#   Máscara   255.255.255.0
#   Gateway   192.168.1.1   (la IP del router)
#
# Si la IP cambia, las comandas se quedan EN COLA (no se pierden) y salen solas
# al corregirla. Comprueba con Ajustes -> Impresoras -> Probar cocina.
PRINTER_COCINA=tcp://192.168.1.50:9100

# En desarrollo (macOS/Linux, sin hardware) se puede ver el papel en disco:
# PRINTER_CAJA=file://./server/data/tickets
# PRINTER_COCINA=file://./server/data/tickets

# ---------------------------------------------------------------- respaldos
# Copia completa diaria en server/data/backups/. Si la PC estuvo apagada a la
# hora programada, la copia se hace al encenderla.
BACKUP_AUTO=on
BACKUP_HORA=3          # a partir de esta hora (0-23)
BACKUP_CONSERVAR=30    # días de copias locales que se guardan

# --- Sacar el respaldo del local (elige UNA opción) ---

# OPCIÓN A (recomendada): carpeta sincronizada.
# Instalar "Google Drive para escritorio" (o usar OneDrive, que ya viene con
# Windows), iniciar sesión con la cuenta del negocio y apuntar aquí a una
# carpeta dentro de la unidad sincronizada. El programa solo copia un archivo;
# de subirlo se encarga Drive. Sin credenciales, sin tokens que caduquen.
# BACKUP_COPIA=G:\Mi unidad\Respaldos FUWA

# OPCIÓN B: API de Google Drive con cuenta de servicio.
# OJO: una cuenta de servicio NO tiene almacenamiento propio en cuentas
# personales de Gmail — la subida falla con "storageQuotaExceeded". Solo sirve
# con Google Workspace y una unidad compartida donde la cuenta de servicio sea
# miembro. Para una cuenta normal de Gmail, usar la OPCIÓN A.
# BACKUP_DRIVE_CREDENCIALES=C:\fuwa\credenciales-drive.json
# BACKUP_DRIVE_CARPETA=1AbCdEfGhIjKlMnOpQrStUvWxYz
