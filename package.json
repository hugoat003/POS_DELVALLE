{
  "name": "fuwa-pos",
  "private": true,
  "version": "1.0.0",
  "description": "Punto de venta para la cafetería FUWA (estilo asiático kawaii). Moneda: Quetzal (Q).",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n server,vite \"node --env-file-if-exists=.env server/index.js\" \"vite\"",
    "server": "node --env-file-if-exists=.env server/index.js",
    "build": "vite build",
    "preview": "vite preview",
    "start": "npm run build && node --env-file-if-exists=.env server/index.js"
  },
  "dependencies": {
    "better-sqlite3": "^12.11.1",
    "express": "^4.22.2",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^10.0.3",
    "playwright": "^1.61.1",
    "vite": "^5.4.11"
  }
}
